{
  "name": "learning-planet",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build:earth-orbit": "vite build",
    "typecheck": "tsc --noEmit",
    "test:earth-orbit": "vitest run",
    "build:experiments": "vite build --config vite.experiments.config.ts",
    "build:stories": "vite build --config vite.story.config.ts",
    "check": "npm run typecheck && npm run test:earth-orbit && npm run build:earth-orbit && npm run build:experiments && npm run build:stories && npm run build:little-star",
    "deploy": "npx -y firebase-tools@latest deploy --only hosting",
    "deploy:all": "npx -y firebase-tools@latest deploy",
    "build:little-star": "vite build --config vite.little-star.config.ts"
  },
  "dependencies": {
    "pixi.js": "^8.18.1",
    "rubiks-cube-solver": "^1.2.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/three": "^0.180.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
